# ═══════════════════════════════════════════════════════════
# TravelAdvisor Backend — Environment Configuration Template
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it is already in .gitignore.
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# HOST is optional — defaults to 0.0.0.0 (required for Render)
HOST=0.0.0.0

# ─────────────────────────────────────────────────────────
# MySQL Database Configuration (Local Development)
# ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=travel_advisor_db

# ─────────────────────────────────────────────────────────
# MySQL Database Configuration (Production / Cloud)
# Use DATABASE_URL OR individual DB_* vars — not both.
# Format: mysql://user:password@host:port/database?ssl-mode=REQUIRED
# ─────────────────────────────────────────────────────────
# DATABASE_URL=mysql://user:password@your-cloud-host:3306/travel_advisor_db

# ─────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────
# Use a long, random string in production (min 32 characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────
# CORS Configuration
# ─────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production:  https://your-app-name.onrender.com
# Multiple origins (comma-separated): https://app1.com,https://app2.com
CORS_ORIGIN=http://localhost:3000

# Frontend URL (used for redirects / email links if needed)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────
# File Upload Configuration
# ─────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
