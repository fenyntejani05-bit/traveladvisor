# TravelAdvisor Frontend — Environment Configuration Template
# Copy this file to .env and adjust as necessary:
#   cp .env.example .env
#
# NEVER commit .env to Git — it is already in .gitignore.

# ─────────────────────────────────────────────────────────
# API Base URL
# ─────────────────────────────────────────────────────────
# Development (local backend):
REACT_APP_API_URL=http://localhost:5000/api

# Production (Render backend — update after first deploy):
# REACT_APP_API_URL=https://traveladvisor-api.onrender.com/api
